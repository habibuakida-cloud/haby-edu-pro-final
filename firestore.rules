rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150
        && request.resource.data.className is string && request.resource.data.className.size() <= 50
        && request.resource.data.feeStatus in ['PAID', 'UNPAID']
        && request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 128;
      allow delete: if isValidId(studentId);
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150
        && request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 128;
      allow delete: if isValidId(teacherId);
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update: if isValidId(schoolId)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200;
      allow delete: if isValidId(schoolId);
    }

    // Daily Attendance collection
    match /daily_attendance/{attendanceId} {
      allow read: if true;
      allow create: if isValidId(attendanceId)
        && request.resource.data.studentId is string && request.resource.data.studentId.size() <= 128
        && request.resource.data.teacherId is string && request.resource.data.teacherId.size() <= 128
        && request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 128
        && request.resource.data.status in ['PRESENT', 'ABSENT']
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
