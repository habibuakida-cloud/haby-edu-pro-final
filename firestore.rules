rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // School Snapshot Validation
    function isValidSchool(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.updatedAt is timestamp;
    }

    match /schools/{schoolId} {
      allow get, list: if true;
      allow write: if isValidId(schoolId) && isValidSchool(request.resource.data);
    }

    // Gate Pass Validation
    function isValidGatePass(data) {
      return data.keys().hasAll(['studentName', 'regNo', 'className', 'type', 'reason', 'officerName', 'schoolId']) &&
             data.studentName is string &&
             data.regNo is string &&
             data.className is string &&
             data.type in ['CHECK_IN', 'CHECK_OUT'] &&
             data.reason is string &&
             data.officerName is string &&
             data.schoolId is string;
    }

    match /gate_pass_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidGatePass(request.resource.data);
    }

    // Attendance Validation
    function isValidAttendance(data) {
      return data.keys().hasAll(['school_id', 'date', 'period_number', 'class_name', 'status', 'updatedAt']) &&
             data.school_id is string &&
             data.date is string &&
             data.period_number is int &&
             data.status in ['taught', 'not_taught'] &&
             data.updatedAt is timestamp;
    }

    match /period_attendance/{attendanceId} {
      allow get, list: if resource == null || resource.data.school_id is string;
      allow create, update: if isValidId(attendanceId) && isValidAttendance(request.resource.data);
    }

    match /school_subscriptions/{schoolId} {
      allow get, list: if true;
      allow write: if isValidId(schoolId);
    }
  }
}
