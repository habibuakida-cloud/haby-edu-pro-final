rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write on users collection for authentication and profile lookup
    match /users/{userId} {
      allow read, write: if true;
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    // Gate Pass Logs
    match /gate_pass_logs/{logId} {
      allow read, write: if true;
    }

    // Period Attendance
    match /period_attendance/{attendanceId} {
      allow read, write: if true;
    }

    // School Subscriptions
    match /school_subscriptions/{schoolId} {
      allow read, write: if true;
    }

    // Global fallback for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
